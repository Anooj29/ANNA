# Copy this to .env and adjust as needed. Both docker-compose and the
# dashboards read the POSTGRES_* values; run.sh / CMake load .env
# automatically if present.

# "sqlite" (default) needs zero setup - a single file on disk, perfect for
# developing/testing on one machine. Switch to "postgres" once multiple
# dashboards on different machines need to share the same live data.
DB_ENGINE=sqlite
SQLITE_PATH=anna_dashboard.db

# Only read when DB_ENGINE=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anna_hospital
POSTGRES_USER=anna
POSTGRES_PASSWORD=anna_dev_password

# Total beds to seed on first run (dashboards/init_db.py only adds beds,
# never removes them, so raising this later is safe).
HOSPITAL_TOTAL_BEDS=20

# Prefix used when generating patient IDs, e.g. ANP-00001.
PATIENT_ID_PREFIX=ANP

RECEPTIONIST_PORT=8001
CLINICIAN_PORT=8002
PATIENT_PORT=8003
VISION_PORT=8004

# Required before exposing the clinician dashboard on a hospital network.
CLINICIAN_EMAIL=doctor@anna.local
CLINICIAN_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=replace-this-with-a-long-random-secret
# Shared only with the robot controller. It authorises task polling/status updates.
ROBOT_API_KEY=change-robot-key

# Robot point-of-view dashboard. Set the stream URL to the Raspberry Pi's
# reachable address. The token should be a long, unique secret in production.
ROBOT_VISION_STREAM_URL=http://anna-robot.local:8080/stream.mjpg
ROBOT_VISION_STREAM_TOKEN=replace-with-a-long-random-vision-token

# ---------------------------------------------------------------------------
# Robot config (see anna_robot/config.py for the full list, and the README
# for what each one does). Repeated here so one .env covers the project.
# Everything below is optional - the defaults match the original hardware.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# ROBOT_KNOWN_FACES_DIR=known_faces
# ROBOT_VISION_STREAM_ENABLED=true
# ROBOT_VISION_STREAM_HOST=0.0.0.0
# ROBOT_VISION_STREAM_PORT=8080

# Objects ANNA reports. Person is the one that drives behaviour; keep the
# rest short, since every extra class is more to draw and stream.
# ROBOT_DETECTION_CLASSES=person,chair,couch,bed,dining table,tv

# Speech. ANNA answers to "Hey ANNA" and "Yes ANNA"; after a wake word she
# stays attentive for this long so a follow-up needs no wake word.
# ROBOT_WAKE_WINDOW_S=12
# ROBOT_REQUIRE_WAKE_WORD=false
# How long "stop" keeps ANNA still before she may drive again.
# ROBOT_STOP_HOLD_S=5
# Listen on a microphone attached to the Pi as well as via the companion
# app. Needs: pip install -r requirements-optional.txt
# ROBOT_MIC_ENABLED=false

# Person following (PID on visual feedback).
# ROBOT_FOLLOW_DISTANCE_CM=90
# ROBOT_FOLLOW_MAX_LINEAR=0.75
# ROBOT_FOLLOW_MAX_ANGULAR=0.65
# ROBOT_BEARING_KP=0.85
# ROBOT_BEARING_KI=0.05
# ROBOT_BEARING_KD=0.12
# ROBOT_RANGE_KP=1.30
# ROBOT_RANGE_KI=0.10
# ROBOT_RANGE_KD=0.15

# Pan/tilt head. Set both pins to enable it.
#
# SAFETY: the head carries the camera cabling, so it must never be able to
# rotate freely. These limits are hard-enforced in the servo driver and
# validated at startup - measure the real cable slack before widening them.
# ROBOT_HEAD_PAN_PIN=12
# ROBOT_HEAD_TILT_PIN=13
# ROBOT_HEAD_PAN_MIN_DEG=-70
# ROBOT_HEAD_PAN_MAX_DEG=70
# ROBOT_HEAD_TILT_MIN_DEG=-30
# ROBOT_HEAD_TILT_MAX_DEG=30

# Future feedback hardware: both segments are implemented and switched off
# until the hardware is fitted.
# ROBOT_ENCODER_ENABLED=false
# ROBOT_ENCODER_LEFT_PIN=20
# ROBOT_ENCODER_RIGHT_PIN=21
# ROBOT_IMU_ENABLED=false

# Performance. Raise DETECT_EVERY_N_FRAMES or lower FACE_DETECTION_SCALE if
# the loop is running slowly on your Pi.
# ROBOT_DETECT_EVERY_N_FRAMES=2
# ROBOT_FACE_DETECTION_SCALE=0.5
# ROBOT_CONTROL_LOOP_FPS=20

# Dry run: start the whole control stack with nothing physically moving.
# ROBOT_SIMULATE_HARDWARE=false
