# Copy this to .env and adjust as needed. Both docker-compose and the
# dashboards read the POSTGRES_* values; run.sh / CMake load .env
# automatically if present.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anna_hospital
POSTGRES_USER=anna
POSTGRES_PASSWORD=anna_dev_password

# Total beds to seed on first run (dashboards/init_db.py only adds beds,
# never removes them, so raising this later is safe).
HOSPITAL_TOTAL_BEDS=20

# Prefix used when generating patient IDs, e.g. ANP-00001.
PATIENT_ID_PREFIX=ANP

RECEPTIONIST_PORT=8001

# Existing robot config (see anna_robot/config.py) - repeated here so one
# .env file covers the whole project.
# GEMINI_API_KEY=
# ROBOT_KNOWN_FACES_DIR=known_faces
